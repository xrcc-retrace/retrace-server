.env
.venv/
__pycache__/
*.pyc
gemini_live_playground/logs/

# Runtime-mutated SQLite database — production server writes to this,
# tracking it would break `git pull` on every deploy.
data/retrace.db
data/retrace.db-journal
data/retrace.db-wal
data/retrace.db-shm

# User-generated and runtime-rendered artifacts. Same reason as the DB:
# the production server writes here on every upload, manual ingest, and
# icon render — tracking them would break `git pull` on deploy and would
# also push local demo recordings to the public repo.
uploads/
data/clips/
data/manuals/
data/manual_images/
data/icons/
# Phone-uploaded expert-interview logs (services/expert_interview/store.py).
data/interviews/

# Per-box lens-encode marker (services/lens_variants.py) — records which
# LENS_ENCODE_VERSION the box's _lens.mp4 variants were generated at. Each
# deployment stamps its own; tracking it would defeat the startup refresh.
data/lens_encode_version

# Eval harness dev artifacts — test-input frames harvested from expert videos
# and per-run report outputs. The eval *source* under evals/ is tracked; these
# subtrees are large (frames) or ephemeral (reports) and dev-only — EXCEPT
# fixtures/staged/, which holds hand-curated ground-truth label frames
# (step_{n}_{done|notdone|errorK}) that eval_oracle scores against; those are
# labels, not derived artifacts, and are tracked.
evals/fixtures/*
!evals/fixtures/staged/
evals/reports/
.claude/worktrees/
